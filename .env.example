# Секреты и конфигурация. Этот файл в git — шаблон. Реальные значения в `.env`,
# который НЕ коммитится (проверяется в .gitignore).

# Скопируй и заполни:
#   cp .env.example .env
# PowerShell:
#   Copy-Item .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО ДЛЯ ПУБЛИКАЦИИ
# ─────────────────────────────────────────────────────────────────────────────

# Канонический origin. Подставляется в canonical, og:url, hreflang, sitemap,
# RSS и llms.txt. Неверное значение активно вредит SEO, а localhost уедет в
# прод с sitemap из localhost-адресов.
#
#   Деплой:  $env:PUBLIC_SITE_URL="https://<домен>"; npm run deploy
#   Или:     PUBLIC_SITE_URL=... в .env, и Astro подхватит сам.
PUBLIC_SITE_URL=https://blender-mcp-wiki.refertur.net

# Cloudflare Pages. Нужны, чтобы `wrangler pages deploy` работал без
# интерактивного `wrangler login` — то есть в CI и в автоматическом деплое.
#
# Как получить, не выдавая глобальный API-ключ:
#   Dashboard → My Profile → API Tokens → Create Token
#   Template "Edit Cloudflare Workers" + добавить разрешение
#   "Workers Scripts: Edit" и "Account Settings: Read" для нужного аккаунта.
#
# Account ID: Dashboard → боковая панель → Account ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# НУЖНО ТОЛЬКО ЕСЛИ ПУШИТЬ ИЗ CI ИЛИ АГЕНТА
# ─────────────────────────────────────────────────────────────────────────────

# Fine-grained PAT. Права минимально достаточные: только Contents: Read and write
# на конкретный репозиторий, без доступа к остальным.
#   GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
#
# Нужен, если публикация в GitHub будет автоматической. Для ручного `git push`
# из вашей машины ключ не требуется.
GH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# НЕОБЯЗАТЕЛЬНО: ключи, упомянутые в статьях корпуса
# ─────────────────────────────────────────────────────────────────────────────
#
# Эти имена НЕ читает ни один скрипт репозитория. Они приведены, потому что
# статьи про генерацию 3D учат их использовать, и владельцу нужно понимать,
# что для самой публикации вики они не требуются. Если захочешь запускать
# генерацию из статьи, ключи клади сюда, а не в текст статьи.

# Tripo AI — генерация 3D по тексту/изображению (см. setup_42, setup_43)
TRIPO_API_KEY=

# Hyper3D Rodin — см. setup_44
BLENDERMCP_HYPER3D_API_KEY=

# Hunyuan3D — см. setup_45
BLENDERMCP_HUNYUAN3D_SECRET_ID=
BLENDERMCP_HUNYUAN3D_KEY=
# Свой сервис вместо облака: задаёшь URL — получаешь локальный бэкенд.
BLENDERMCP_HUNYUAN3D_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# НЕОБЯЗАТЕЛЬНО: ИИ для работы над контентом
# ─────────────────────────────────────────────────────────────────────────────
#
# Не нужны ни для сборки, ни для публикации. Нужны, если агент будет дописывать
# статьи или переводы. Держи в `.env`, не в промптах и не в статьях.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ПРАВИЛА
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. `.env` никогда не коммитится. `.env.example` — единственный файл с именами.
# 2. Не пиши ключи в статьи вики, в README, в CHANGELOG и в сообщения коммитов:
#    они попадают в историю git навсегда.
# 3. Ключ, утёкший в git, считается скомпрометированным — отзывай и перевыпускай,
#    а не удаляй строку из файла.
# 4. Для публичных репозиториев ключи храни в GitHub Secrets, а не в `.env`.