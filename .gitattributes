# Normalise line endings on commit; keep LF in the working tree.
# The corpus is authored on Windows, and markdown files are read as UTF-8 with
# universal newlines, so this changes nothing functionally — it only keeps diffs
# stable across machines.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.blend binary
