# Canonical origin of the deployed site.
#
# The hostname is fixed: blendee-skills.refertur.net
# Its apex zone (refertur.net) is served by Timeweb, so a CNAME has to be added
# there — not at the registrar (Spaceship).
#
#   CNAME  blendee-skills  blendee-skills.pages.dev
#
# Copy this file to .env and set the value before deploying. Never commit .env.
PUBLIC_SITE_URL=https://blendee-skills.refertur.net
