# Canonical origin of the deployed site.
#
# The hostname is fixed: blender-mcp-wiki.r00m.ru
# Its apex zone (r00m.ru) is served wherever the owner keeps it — at the time of
# writing the CNAME is added there, not at the registrar for the old domain.
#
#   CNAME  blender-mcp-wiki  blender-mcp-wiki.pages.dev
#
# Copy this file to .env and set the value before deploying. Never commit .env.
PUBLIC_SITE_URL=https://blender-mcp-wiki.r00m.ru
