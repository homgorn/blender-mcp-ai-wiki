---
import { entryUrl, isIndexable, type Entry } from '../lib/content';
import { CATEGORY_META } from '../lib/site';

interface Props {
  entry: Entry;
  /** Show the description paragraph. */
  showDesc?: boolean;
}

const { entry, showDesc = true } = Astro.props;
const cat = CATEGORY_META[entry.category];
---

<a class="card" href={entryUrl(entry)} data-pagefind-ignore>
  <h3>{entry.title}</h3>
  <div class="meta">
    <span>{cat?.icon ?? '📄'} {cat?.ru ?? entry.category}</span>
    {entry.difficulty > 0 && <span>⭐{'★'.repeat(entry.difficulty)}</span>}
    {entry.status && (
      <span class={entry.status === 'full' ? 'badge full' : 'badge warn'}>
        {entry.status}
      </span>
    )}
    {!isIndexable(entry) && <span class="badge warn" title="Шаблонный перевод">template</span>}
  </div>
  {showDesc && entry.description && <p class="desc">{entry.description}</p>}
  {entry.tags.length > 0 && (
    <div class="tags">
      {entry.tags.slice(0, 5).map((t) => <span class="tag">#{t}</span>)}
    </div>
  )}
</a>
