---
/**
 * Renders an entry's markdown body to HTML at build time.
 *
 * Uses `marked` (no remark/rehype pipeline) because the bodies arrive as raw
 * strings from the JSON database, not as project .md files. Astro 7 replaced the
 * default markdown processor ("Sätteri"), so relying on Astro's pipeline for
 * arbitrary strings is not an option; `marked` is explicit and dependency-light.
 *
 * `data-pagefind-body` marks the article text as the searchable region
 * (Pagefind requirement).
 */
import { marked } from 'marked';
import { codeToHtml } from 'shiki';
import { bodyLinks, type Entry } from '../lib/content';


interface Props {
  entry: Entry;
  class?: string;
}

const { entry, class: className = 'prose' } = Astro.props;

/** Raw body href (lowercased) -> site URL, computed once per entry in content.ts. */
const RESOLVED = bodyLinks(entry);

marked.setOptions({ gfm: true, breaks: false });

// Headings get stable ids so deep links (#errors) and TOCs work.
let h = 0;
const slugger = new Map<string, number>();
function headingId(text: string): string {
  const base = text
    .toLowerCase()
    .replace(/[`*_[\]()#]/g, '')
    .replace(/[^\p{L}\p{N}]+/gu, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60) || 'section';
  const n = slugger.get(base) ?? 0;
  slugger.set(base, n + 1);
  return n === 0 ? base : `${base}-${n}`;
}

const renderer = new marked.Renderer();
renderer.heading = function ({ tokens, depth }) {
  const text = this.parser.parseInline(tokens);
  const plain = text.replace(/<[^>]+>/g, '');
  const id = depth >= 2 && depth <= 3 ? headingId(plain) : '';
  return `<h${depth}${id ? ` id="${id}"` : ''}>${text}</h${depth}>\n`;
};
// Internal links: rewritten to the real site URL, localised to the reader's
// language. Without this the body ships raw relative `.md` paths
// (`../setups/setup_01_...md`) that resolve to URLs which do not exist, and the
// site published `setup-01-...` rather than `setup_01_...`. 2 227 such links on
// 446 of 916 pages. A target that is not in the published set is left alone so
// the dead-link gate can see it and report it rather than have it silently
// mangled.
renderer.link = function ({ href, title, tokens }) {
  const text = this.parser.parseInline(tokens);
  const raw = href ?? '';
  const ext = /^https?:\/\//i.test(raw);
  const resolved = ext ? undefined : RESOLVED.get(raw.toLowerCase());
  const attrs = [
    `href="${resolved ?? raw}"`,
    title ? ` title="${title}"` : '',
    ext ? ' rel="noopener noreferrer nofollow"' : '',
  ].join('');
  return `<a ${attrs}>${text}</a>`;
};

const html = marked.parse(entry.body, { renderer, async: false }) as string;

/**
 * Syntax highlighting, done after markdown rendering.
 *
 * `marked` emits bare <pre><code class="language-x">. Rather than re-plumb
 * marked's async walk, the already-rendered HTML is post-processed: the corpus
 * is code-heavy (5 120 blocks) and a regex over <pre> is predictable here —
 * marked escapes the content, so the pattern cannot appear inside a code block
 * by accident.
 *
 * A language with no Shiki grammar falls back to escaped plain text rather than
 * failing the build: an unknown language must never break a page.
 */
const LANGS: Record<string, string> = {
  py: 'python', python: 'python', bash: 'bash', sh: 'bash', shell: 'bash',
  powershell: 'powershell', ps1: 'powershell', json: 'json', yaml: 'yaml',
  yml: 'yaml', js: 'javascript', javascript: 'javascript', ts: 'typescript',
  typescript: 'typescript', glsl: 'glsl', c: 'c', cpp: 'cpp', cxx: 'cpp',
  go: 'go', rust: 'rust', rs: 'rust', sql: 'sql', html: 'html', xml: 'xml',
  ini: 'ini', toml: 'toml', diff: 'diff', text: 'text', txt: 'text', '': 'text',
  // Git config files are INI-shaped; there is no grammar of their own.
  gitattributes: 'ini', gitignore: 'ini', conf: 'ini', cfg: 'ini',
};

let highlighted = 0;
let failed = 0;
const finalHtml = await (async () => {
  const blocks = [...html.matchAll(
    /<pre><code(?: class="language-([\w+#-]+)")?>([\s\S]*?)<\/code><\/pre>/g,
  )];
  if (!blocks.length) return html;
  const out: string[] = [];
  let last = 0;
  for (const m of blocks) {
    out.push(html.slice(last, m.index));
    const lang = LANGS[(m[1] ?? '').toLowerCase()] ?? (m[1] ?? '');
    const code = m[2]
      .replace(/&lt;/g, '<').replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&');
    try {
      const themed = await codeToHtml(code, {
        lang: lang || 'text',
        theme: 'github-dark',
        transformers: [],
      });
      out.push(themed);
      highlighted++;
    } catch {
      // Unknown grammar: keep the escaped original.
      out.push(m[0]);
      failed++;
    }
    last = m.index + m[0].length;
  }
  out.push(html.slice(last));
  return out.join('');
})();

// No build-time logging here: Astro re-evaluates this module per page, so any
// "log once" guard would print 900 lines. Whether highlighting actually landed
// is verified against the built output in scripts/verify-seo.mjs, which is the
// only place a measurement of an artifact belongs.

// Table of contents from h2/h3 — also used by the sidebar.
const toc = [...entry.body.matchAll(/^(#{2,3})\s+(.+)$/gm)].map((m) => ({
  level: m[1].length,
  text: m[2].replace(/[`*]/g, '').trim(),
}));
---

{/*
  The wrapper carries `className`, and until it existed the whole `.prose`
  stylesheet — max-width 78ch, h2/h3 rules, blockquote styling and, most
  visibly, `pre { overflow-x: auto }` — applied to nothing. `class` was
  destructured with a default of 'prose' and then never used, so all 222
  articles rendered unstyled code blocks that pushed the page to a 1240px
  scrollWidth on a 390px screen.

  The element is a `div` rather than a bare Fragment because a Fragment cannot
  take a class: there is no node to hang the styling on.
*/}
<div class={className} set:html={finalHtml} />

<style>
  [data-pagefind-body] a[rel~='nofollow']::after {
    content: '↗';
    font-size: 0.8em;
    margin-left: 2px;
    color: var(--text-faint);
  }
  /* Shiki inlines its own colours; the prose rule must not fight them. */
  .prose :is(pre, pre code) {
    background: transparent !important;
    color: inherit;
  }
  .prose pre.shiki {
    background: var(--panel-2) !important;
    padding: 14px 16px;
  }
</style>
