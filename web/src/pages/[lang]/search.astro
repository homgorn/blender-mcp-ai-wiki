---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANG_META, LANGS, SITE_NAME, CATEGORY_META } from '../../lib/site';
import { entries, isIndexable, popular, originals, slugify } from '../../lib/content';
import { abs } from '../../lib/seo';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: 'ru' | 'en' | 'es' | 'de' | 'zh' };
const suggested = popular(lang, 12);
const cats = [...new Set(originals.map((e) => e.category))];
// entryUrl, not a local slugify copy: the copy omitted the `.md` strip and the
// dash trim, and five ids contain a space.
const urlOf = (e: { category: string; origId: string }) => `/${lang}/${e.category}/${slugify(e.origId)}`;
---

<BaseLayout
  title={`Поиск · ${SITE_NAME}`}
  description={`Поиск по ${entries.filter(isIndexable).length} статьям базы знаний Blender, MCP и AI-агентов.`}
  path={`/${lang}/search`}
  lang={lang}
  noindex={true}
  alternates={LANGS.map((l) => ({ hreflang: LANG_META[l].locale, href: abs(`/${l}/search`) }))}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
  </Fragment>

  <div class="wrap">
    <div class="hero" style="border:0;padding-bottom:16px">
      <h1>Поиск</h1>
      <p>
        Индекс строится на этапе сборки (Pagefind): поиск работает без сервера и без
        загрузки всей базы в браузер.
      </p>
    </div>

    <section class="section">
      <pagefind-modal-trigger></pagefind-modal-trigger>
      <pagefind-modal></pagefind-modal>

      <button
        id="pf-open"
        type="button"
        style="padding:10px 18px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--text);cursor:pointer;font-size:15px"
      >
        Открыть поиск по базе
      </button>

      <noscript>
        <p class="notice">
          Поиск требует JavaScript. Без него используйте <a href={abs('/llms.txt')}>llms.txt</a>,
          <a href={abs('/llms-full.txt')}>llms-full.txt</a> или
          <a href={abs('/rss.xml')}>RSS</a>.
        </p>
      </noscript>

      {/*
        The opener is wired from a module, not from an inline `onclick`.

        The site serves `script-src 'self' 'wasm-unsafe-eval'` — no
        `'unsafe-inline'` — so the inline handler this button used to carry was
        refused by the site's own CSP. The button looked fine and did nothing,
        and `<pagefind-modal-trigger>` does not render a usable shadow button in
        this build, so there was no working path to the modal at all.

        An Astro `<script>` is bundled and served from 'self', which the policy
        allows. Widening the policy to 'unsafe-inline' would have been the
        one-line fix and the wrong one: it trades CSP protection for the whole
        site to restore one button.
      */}
      <script>
        const btn = document.getElementById('pf-open');
        const modal = document.querySelector('pagefind-modal');
        btn?.addEventListener('click', () => {
          (modal as unknown as { showModal?: () => void })?.showModal?.();
        });
      </script>
    </section>

    <section class="section">
      <h2>Категории</h2>
      <div class="tags" style="gap:10px">
        {cats.map((c) => (
          <a class="tag" style="padding:4px 12px;font-size:13px" href={`/${lang}/${c}`}>
            {CATEGORY_META[c]?.icon} {CATEGORY_META[c]?.ru ?? c}
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Популярное</h2>
      <ul>
        {suggested.map((e) => (
          <li style="margin:6px 0"><a href={urlOf(e)}>{e.title}</a></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
